{
  "info": {
    "name": "Biblioteca GG API v1",
    "description": "Colección de los endpoints funcionales. Ejecuta Login y luego el resto, que hereda el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login bibliotecario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = pm.response.json();",
              "pm.collectionVariables.set('token', cuerpo.datos.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"gerardo@bibliotecagg.edu\",\n  \"password\": \"Biblioteca123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Listar libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/libros"
      }
    },
    {
      "name": "Detalle de libro",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/libros/1"
      }
    },
    {
      "name": "Crear libro",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isbn\": \"9780134685991\",\n  \"titulo\": \"Effective Java\",\n  \"autor\": \"Joshua Bloch\",\n  \"editorial\": \"Addison-Wesley\",\n  \"anio\": 2018,\n  \"resumen\": \"Oficio en Java.\",\n  \"etiquetas\": [\"java\"]\n}"
        },
        "url": "{{baseUrl}}/api/v1/libros"
      }
    },
    {
      "name": "Crear prestamo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": 3,\n  \"libroId\": 1,\n  \"fechaPrestamo\": \"2026-10-22T00:00:00.000Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prestamos"
      }
    },
    {
      "name": "Listar prestamos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/prestamos"
      }
    }
  ]
}
